{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "my-wallet",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "my-wallet-copia",
